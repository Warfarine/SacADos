  "nailFungus": "Nail fungus",
  "@nailFungus": {
    "description": "header nail fungus"
  },
  "nailFungusLabel": "Infection of the nails caused by a fungus",
  "@nailFungusLabel": {
    "description": "nail fungus header label"
  },
  "nailFungusDef": "Nail fungus is a problem of the nails caused by coming into contact with a small fungus (mushroom). It is very common and can be treated",
  "@nailFungusDef": {
    "description": "definition nail fungus"
  },
  "nailFungusSxHeader": "Nail fungus symptoms",
  "@nailFungusSxHeader": {
    "description": "nail fungal infection sx"
  },
  "nailFungusSx": "● Nails look more yellow or brown 🟡🟤\n● Nail thickening\n● Nails that crack or break\n● The nail can detach from the nail bed\n● Might have a bad smell\n● Pain",
  "@nailFungusSx": {
    "description": "nail fungal infection sx"
  },
  "nailFungusImages": "Click here to see images of nail fungus",
  "@nailFungusImages": {
    "description": "dialog box for nail fungus images "
  },
  "nailFungusImage1": "Thicker nail, yellow in color, some redness & swelling around the nailbed",
  "@nailFungusImage1": {
    "description": "nail fungus image"
  },
  "nailFungusImage2": "Nails are yellowed and are very brittle and ragged",
  "@nailFungusImage2": {
    "description": "nail fungus image"
  },
  "nailFungusImage3": "Nail is discolored, visibly ragged. Some redness around the nailbed",
  "@nailFungusImage3": {
    "description": "nail fungus image "
  },
  "nailFungusImage4": "Nails are discolored, visibly deformed and very brittle",
  "@nailFungusImage4": {
