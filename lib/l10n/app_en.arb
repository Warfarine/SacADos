  "cuts": "Cuts & scrapes",
  "@cuts": {
    "description": "Header for cuts & scrapes"
  },
  "cutsImages": "Click here to see images of cuts that need stitches",
  "@cutsImages": {
    "description": "Dialog box for cut images"
  },
  "cutsStep1a": "Look at your wound — if you see any of the following, you might need stitches 🪡",
  "@cutsStep1a": {
    "description": "Step 1a for cuts"
  },
  "cutsStep1aExtra": "Look at your wound — if you see the following, you might need a tetanus shot 💉",
  "@cutsStep1aExtra": {
    "description": "Step 1a suite for cuts"
  },
  "cutsStep1b": "● Larger than 1/2\" or 2 cm\n● Deeper than 1/4\" or 6 mm",
  "@cutsStep1b": {
    "description": "Step 1b for cuts"
  },
  "cutsStep1c": "● Visible fatty tissue, tendons or muscle",
  "@cutsStep1c": {
    "description": "Step 1c for cuts"
  },
  "cutsStep1d": "● Dirt, grit or glass in the wound",
  "@cutsStep1d": {
    "description": "Step 1d for cuts"
  },
  "cutsStep1e": "Find a clean cloth or towel to cover your wound and seek medical care",
  "@cutsStep1e": {
    "description": "Step 1e for cuts"
  },
  "cutsStep1ok": "If the wound does not requires immediate medical attention, follow these steps to help it heal",
  "@cutsStep1ok": {
    "description": "Proceed to step 2 for cuts"
  },
  "cutsStep2": "1. Clean your wound with mild soap and lukewarm water for 5-10 minutes",
  "@cutsStep2": {
    "description": "Step 2 for cuts"
  },
  "cutsStep3": "2. Gently pat dry with a clean cloth or towel",
  "@cutsStep3": {
    "description": "Step 3 for cuts"
  },
  "cutsStep4": "3. If the wound is bleeding, take a clean cloth or towel and apply firm pressure for 15 minutes",
  "@cutsStep4": {
    "description": "Step 4 for cuts"
  },
  "cutsStep4a": "If the bleeding does not lessen or stop after 15 minutes, seek medical care immediately",
  "@cutsStep4a": {
    "description": "Step 4a for cuts"
  },
  "cutsStep5": "Never put these products on your wound as they damage the skin: \n\n● Rubbing alcohol ❌\n● Hydrogen peroxide ❌\n● Bleach ❌",
  "@cutsStep5": {
    "description": "Step 5 for cuts"
  },
  "cutsStep6": "● Apply a clean self-adhesive bandage like a Band-aid to the wound\n● For larger wounds, apply a compress over the wound and secure it with medical tape or a gauze roll\n● The dressing should be snug, but it shouldn’t cause pain\n● Do not apply any adhesive tape directly to the wound",
  "@cutsStep6": {
    "description": "Step 6 for cuts"
  },
  "cutsStep6Examples": "Examples of dressings",
  "@cutsStep6Examples": {
    "description": "Step 6 for cuts - examples dressings"
  },
  "cutsStep7": "● Keep the dressing dry and clean\n● Change the dressing every 24 hours or if it gets soiled\n● Before removing the old dressing, wash your hands with soap and water for 1 minute 🕐\n● If the dressing is sticking to the wound, gently run if under warm water to help remove it 🚿\n● Always take a good look at the wound before putting a new dressing for signs of infection",
  "@cutsStep7": {
    "description": "Step 7 for cuts"
  },
  "cutsStep8": "Typically, minor wounds will heal within 7 to 10 days",
  "@cutsStep8": {
    "description": "Step 8 for cuts"
  },
