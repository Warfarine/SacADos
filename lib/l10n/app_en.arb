  "@afTxHeader": {
    "description": "tx for athelete's foot header"
  },
  "afTx": "There are antifungal creams that exist for mild cases of athlete's foot. Always ask the pharmacist for help\n\nFor more severe cases, consult a doctor",
  "@afTx": {
    "description": "Treatment options for athlete's foot"
  },
