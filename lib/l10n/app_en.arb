  "afPreventionHeader": "Preventing athlete's foot",
  "@afPreventionHeader": {
    "description": "prevention af header"
  },
  "afPrevention": "● Keep feet dry and clean\n● Change your socks often 🧦\n● Focus on drying the skin between the toes\n● You can use drying foot powders to help keep feet dry\n● When using shared showers, try to wear sandals or flip-flops 🩴\n● Do not share clothing or towels with others",
  "@afPrevention": {
    "description": "Prevention steps for athlete's foot"
  },
  "afPreventionWarning": "● Do not scratch or touch your feet\n● Try to keep feet clean and dry\n● Seek medical help, especially if you notice signs of infection or have other medical issues like diabetes or circulation problems",
  "@afPreventionWarning": {
    "description": "Warning steps if athlete's foot appears"
  },
