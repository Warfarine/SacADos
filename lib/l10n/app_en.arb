  "athleteFoot": "Athlete's foot",
  "@athleteFoot": {
    "description": "Header for athlete's foot"
  },
  "athleteFootDef": "Athlete's foot is a skin problem caused by coming into contact with a small fungus (mushroom). It is very common and people get it if they walk barefoot in communal showers, lockers or swimming pools",
  "@athleteFootDef": {
    "description": "Definition of athlete's foot"
  },
  "athleteFootImages": "Click here to see images of athlete's foot",
  "@athleteFootImages": {
    "description": "Dialog box for athlete's foot images"
  },
  "athleteFootLabel": "Skin infection caused by a fungus",
  "@athleteFootLabel": {
    "description": "Label for athlete's foot header"
  },
  "athleteFootSxHeader": "Athlete's foot symptoms",
  "@athleteFootSxHeader": {
    "description": "Symptoms of athlete's foot header"
  },
  "athleteFootSx": "● Red or darker looking patches 🔴\n● Itchiness and pain\n● Skin might peel or crack, especially between the toes 🦶\n● Soles of the feet might seem thicker, dry and flaky",
  "@athleteFootSx": {
    "description": "Symptoms of athlete's foot"
  },
  "bites": "Bites",
